# Normalize all detected text files and store them with LF in Git
* text=auto eol=lf

# Windows-specific executable scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.br binary
*.pdf binary
*.keystore binary
*.jks binary